{
  "name": "notigen",
  "version": "1.0.0",
  "description": "Laravel notification template management package",
  "scripts": {
    "dev": "npm run development",
    "development": "mix",
    "watch": "mix watch",
    "watch-poll": "mix watch -- --watch-options-poll=1000",
    "hot": "mix watch --hot",
    "prod": "npm run production",
    "production": "mix --production"
  },
  "keywords": [
    "laravel",
    "notifications",
    "templates"
  ],
  "author": "Ramsheed <chatwith@ramsheed.com> (https://github.com/ramshi7134)",
  "license": "MIT",
  "devDependencies": {
    "laravel-mix": "^6.0.49",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.56.1",
    "sass-loader": "^12.1.0"
  }
}
